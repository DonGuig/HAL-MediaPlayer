[Unit]
Description=HAL Media Player OSC server
After=network.target halmp.service

[Service]
User=pi
WorkingDirectory=/home/pi/HAL-MediaPlayer/packages/OSCserver
ExecStart=/home/pi/HAL-MediaPlayer/packages/OSCserver/.venv/bin/python -m halmp_OSCserver
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
