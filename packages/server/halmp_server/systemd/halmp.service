[Unit]
Description=HAL Media Player server
After=network.target sound.target

[Service]
User=pi
WorkingDirectory=/home/pi/HAL-MediaPlayer/packages/server
ExecStart=/home/pi/HAL-MediaPlayer/packages/server/.venv/bin/python -m halmp_server
# Allows binding port 80 without root (replaces authbind)
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
