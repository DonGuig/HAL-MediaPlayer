{
  "name": "halmediaplayer-client",
  "version": "2.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "build": "npm run check && vite build && rm -rf ../server/halmp_server/static/ && mkdir -p ../server/halmp_server/static/ && cp -R ./dist/* ../server/halmp_server/static/",
