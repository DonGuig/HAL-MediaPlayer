{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "compounds": [
        {
            "name": "Run server + client (dev)",
            "configurations": ["Run client (dev)", "run server (python)", "Chrome (dev client)"],
            "stopAll": true
        }
    ],
    "configurations": [

        {
            "name": "Run client (dev)",
            "console": "integratedTerminal",
            "request": "launch",
            "runtimeArgs": [
                "run-script",
                "start"
            ],
            "runtimeExecutable": "npm",
            "runtimeVersion": "24.18.0",
            "cwd": "${workspaceFolder}/packages/client",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "name": "run server (uv python)",
            "type": "debugpy",
            "cwd": "${workspaceFolder}/packages/server/halmp_server",
            "program": "__main__.py",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "run OSC server (python)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 5679
            },
            "preLaunchTask": "run OSC server (uv)",
            "justMyCode": true
        },
        {
            "name": "Chrome (dev client)",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/packages/client/src"
        },
        {
            "name": "Build client (prod)",
            "console": "integratedTerminal",
            "request": "launch",
            "runtimeArgs": [
                "run-script",
                "build"
            ],
            "runtimeExecutable": "npm",
            "runtimeVersion": "24.18.0",
            "cwd": "${workspaceFolder}/packages/client",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "name": "Chrome (prod)",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:5000",
            "webRoot": "${workspaceFolder}"
        },
    ]
}
